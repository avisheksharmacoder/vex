from os import PathLike
from typing import Any, Literal, TypedDict, overload

class VexError(Exception): ...
class VexConflictError(VexError): ...

class StatsDict(TypedDict):
    queries_executed: int
    mutations_committed: int
    wal_lsn: int
    chunks_pruned: int
    logs_emitted: int
    logs_dropped: int
    checkpoints: int
    dead_rows: int

class ColumnView:
    @property
    def name(self) -> str: ...
    @property
    def dtype(self) -> Literal["i64", "u64", "f64", "bool", "str"]: ...
    @property
    def has_nulls(self) -> bool: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> Any: ...
    @overload
    def __getitem__(self, index: slice) -> list[Any]: ...
    def __buffer__(self, flags: int) -> memoryview: ...
    def to_list(self) -> list[Any]: ...
    def np(self) -> Any: ...

class Result:
    @property
    def nrows(self) -> int: ...
    @property
    def ncols(self) -> int: ...
    @property
    def rows_affected(self) -> int: ...
    @property
    def columns(self) -> tuple[str, ...]: ...
    @property
    def explain(self) -> str | None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: str | int) -> ColumnView: ...
    def rows(self) -> list[tuple[Any, ...]]: ...
    def dicts(self) -> list[dict[str, Any]]: ...
    def __arrow_c_stream__(self, requested_schema: Any = ...) -> Any: ...

class Transaction:
    def q(self, query: str, sync: bool = ..., **params: Any) -> Result: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def __enter__(self) -> Transaction: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool: ...

class Database:
    def q(self, query: str, sync: bool = ..., **params: Any) -> Result: ...
    def put(
        self,
        table: str,
        row: dict[str, Any],
        upsert: bool = ...,
        sync: bool = ...,
    ) -> None: ...
    def flush(self) -> None: ...
    def checkpoint(self) -> None: ...
    def stats(self) -> StatsDict: ...
    def tx(self) -> Transaction: ...
    def close(self) -> None: ...
    def _verify_all_segments_crc(self) -> None: ...
    def __enter__(self) -> Database: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> bool: ...

def open(
    path: str | PathLike[str] | None = ...,
    workers: int = ...,
    chunk_rows: int = ...,
    max_readers: int = ...,
    flush_interval_us: int = ...,
    fsync: bool = ...,
    max_memory_bytes: int = ...,
) -> Database: ...

def simd_backend() -> Literal["scalar", "avx2", "neon"]: ...
